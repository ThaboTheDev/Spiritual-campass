<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>TSHK Compass</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>TSHK Compass</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<!-- Schemes url_launcher may hand over to another app: Maps, Safari and Phone. -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>maps</string>
			<string>http</string>
			<string>https</string>
			<string>tel</string>
		</array>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Location: needed to work out the bearing and distance to Ekuphumuleni.
	     Location is used only while the app is open. -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>TSHK Compass uses your location to point the way to Ekuphumuleni, the spiritual capital. · I-TSHK Compass isebenzisa indawo yakho ukukhomba e-Ekuphumuleni, inhlokodolobha yomoya.</string>
		<!-- Motion: iOS asks for motion and orientation access the first time the
	     compass is started. Without it the arrow cannot follow the phone. -->
		<key>NSMotionUsageDescription</key>
		<string>TSHK Compass uses the motion sensors to know which way your phone is facing. · I-TSHK Compass isebenzisa izinzwa zefoni ukwazi ukuthi ubheke ngaphi.</string>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- Portrait only: the dial and the readouts are designed for portrait. -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
		</array>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
